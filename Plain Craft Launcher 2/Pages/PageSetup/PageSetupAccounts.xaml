<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" x:Class="PageSetupAccounts" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanAccounts" Margin="25,25,25,10">
            <local:MyCard x:Name="AccountCard" Title="Minecraft 账号" Margin="0,0,0,15"><StackPanel Margin="25,40,25,18">
                <local:MyComboBox x:Name="AccountList" Height="28" Margin="0,0,0,12" />
                <WrapPanel><local:MyButton x:Name="BtnNew" Text="添加账号" Width="110" Height="32" Margin="0,0,8,8" /><local:MyButton x:Name="BtnDefault" Text="设为默认账号" Width="130" Height="32" Margin="0,0,8,8" /><local:MyButton x:Name="BtnDelete" Text="删除账号" Width="100" Height="32" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock x:Name="DefaultSummary" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ColorBrushGray2}" />
                <local:MyButton x:Name="BtnUseForServer" Text="用于当前服务器" Width="145" Height="32" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Left" />
            </StackPanel></local:MyCard>
            <local:AccountPortrait x:Name="AccountView" Height="210" Margin="0,0,0,15" />
            <local:MyCard x:Name="EditorCard" Title="账号信息" UseAnimation="False" Margin="0,0,0,15"><StackPanel Margin="25,40,25,18">
                <TextBlock Text="账号备注" /><local:MyTextBox x:Name="LabelText" Margin="0,5,0,12" />
                <TextBlock Text="登录方式" /><local:MyComboBox x:Name="TypeList" Height="28" SelectedIndex="0" Margin="0,5,0,12"><local:MyComboBoxItem Content="离线账号" Tag="0" /><local:MyComboBoxItem Content="微软官方账号" Tag="5" /><local:MyComboBoxItem Content="LittleSkin" Tag="littleskin" /><local:MyComboBoxItem Content="第三方账号（Authlib-Injector）" Tag="3" /><local:MyComboBoxItem Content="统一通行证" Tag="2" /></local:MyComboBox>
                <StackPanel x:Name="Credentials">
                    <TextBlock x:Name="UserLabel" Text="玩家名称" /><local:MyTextBox x:Name="UserText" Margin="0,5,0,12" />
                    <StackPanel x:Name="ThirdPartyPanel" Visibility="Collapsed"><TextBlock x:Name="AuthLabel" Text="认证服务器地址（HTTPS）" /><local:MyTextBox x:Name="AuthText" Margin="0,5,0,12" /><TextBlock Text="账号密码" /><PasswordBox x:Name="Secret" Margin="0,5,0,12" /></StackPanel>
                </StackPanel>
                <TextBlock x:Name="OfficialSummary" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
                <WrapPanel><local:MyButton x:Name="BtnSave" Text="保存账号" Width="115" Height="35" ColorType="Highlight" Margin="0,0,8,8" /><local:MyButton x:Name="BtnOfficial" Text="微软授权登录" Width="145" Height="35" Visibility="Collapsed" Margin="0,0,0,8" /><local:MyButton x:Name="BtnThirdLogin" Text="验证登录" Width="115" Height="35" Visibility="Collapsed" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ColorBrushGray2}" />
            </StackPanel></local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
