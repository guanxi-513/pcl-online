<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" x:Class="PagePlayServerDetail" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">
            <TextBlock x:Name="ServerName" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,5" />
            <TextBlock x:Name="AddressText" Foreground="{DynamicResource ColorBrushGray2}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <local:AccountPortrait x:Name="AccountView" Height="230" Margin="0,0,0,15" />
            <StackPanel Margin="0,0,0,18">
                <local:MyComboBox x:Name="AccountChoice" Height="28" Margin="0,0,0,12" />
                <TextBlock x:Name="AccountSummary" Foreground="{DynamicResource ColorBrushGray2}" TextWrapping="Wrap" Margin="0,0,0,15" />
                <WrapPanel><local:MyButton x:Name="BtnSave" Text="保存此服账号" Width="130" Height="35" Margin="0,0,8,8" /><local:MyButton x:Name="BtnAccounts" Text="管理 Minecraft 账号" Width="170" Height="35" Margin="0,0,0,8" /></WrapPanel>
            </StackPanel>
            <WrapPanel><local:MyButton x:Name="BtnJoin" Text="进入游戏" Width="140" Height="35" ColorType="Highlight" Margin="0,0,8,8" /><local:MyButton x:Name="BtnManage" Text="服务器管理" Width="130" Height="35" Visibility="Collapsed" Margin="0,0,0,8" /></WrapPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,10,0,0" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
