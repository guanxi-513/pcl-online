<local:MyPageLeft xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" x:Class="PageServerDeployLeft">
    <Grid MinWidth="280">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <local:MyLoading x:Name="LoadDeploy" AutoRun="False" Height="50" Margin="0,10,0,5" Text="部署服务器" />
            <TextBlock x:Name="LabTitle" Text="正在部署服务器" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrush3}" Margin="15,10,15,0"><TextBlock.RenderTransform><SkewTransform AngleX="-3" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock x:Name="LabName" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource ColorBrush3}" Margin="25,5,25,0" />
            <Grid Height="4" Margin="30,12,30,27">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProgressFinished" Width="0*" /><ColumnDefinition x:Name="ProgressRemaining" Width="1*" /></Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0"><Rectangle.Fill><LinearGradientBrush EndPoint="1,0"><GradientStop Color="{DynamicResource ColorObject4}" /><GradientStop Color="{DynamicResource ColorObject3}" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6" />
            </Grid>
            <TextBlock Text="当前步骤" Opacity="0.5" TextAlignment="Center" FontSize="12.5" />
            <TextBlock x:Name="LabStage" TextWrapping="Wrap" TextAlignment="Center" Margin="20,5,20,15" FontSize="12.5" />
            <TextBlock x:Name="LabProgress" TextAlignment="Center" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12.5" />
            <TextBlock x:Name="LabElapsed" TextAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12.5" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="20,0,20,20">
            <local:MyButton x:Name="BtnManage" Text="服务器管理" Height="35" Margin="0,0,0,10" />
            <local:MyButton x:Name="BtnBack" Text="返回服务器列表" Height="35" />
        </StackPanel>
    </Grid>
</local:MyPageLeft>
