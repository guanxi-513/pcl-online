<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" x:Class="PageServerSelectRight" PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PanMain" Margin="25,25,25,75" /></local:MyScrollViewer>
        <local:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" UseAnimation="False">
            <StackPanel Margin="20,17">
                <TextBlock Text="暂无服务器" FontSize="19" HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,15" />
                <local:MyButton x:Name="BtnNew" Text="添加服务器" Height="35" MinWidth="140" ColorType="Highlight" />
            </StackPanel>
        </local:MyCard>
        <local:MyExtraButton x:Name="BtnAddFloating" ToolTip="部署服务器" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" Height="50" Logo="M14,0 H18 V14 H32 V18 H18 V32 H14 V18 H0 V14 H14 Z">
            <local:MyExtraButton.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></local:MyExtraButton.RenderTransform>
        </local:MyExtraButton>
    </Grid>
</local:MyPageRight>
